# Copy to .env and fill in. .env is git-ignored and must never be committed or published.
# Groq API key for the Ojas AI assistant (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: models to try in order (each has its own free daily quota)
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Optional: extra origins allowed to call /api/chat (comma-separated)
# ALLOWED_ORIGINS=https://bonesip.example

# ---- Accounts, history and admin portal (server/accounts.js) ----
# Folder for the SQLite database file (default ./data). On Docker, mount it as a volume.
# DATA_DIR=/app/data

# Until an SMS service is set up: 1 = every number logs in with OTP_TEST_CODE.
# Anyone who knows a phone number can then open that account, so turn this off for real users.
OTP_TEST_MODE=1
# OTP_TEST_CODE=123456

# Random secret mixed into stored login codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# The one super admin: their 10-digit mobile number and a secret PIN (8+ characters).
# The admin portal is at /admin.html and needs the number, the login code and this PIN.
ADMIN_PHONE=
ADMIN_PIN=
